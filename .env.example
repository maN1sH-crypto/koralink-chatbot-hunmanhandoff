MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=koralink
# Use the local model by default. Set to huggingface to restore the remote provider.
EMBEDDING_PROVIDER=local
EMBEDDING_DEVICE=cpu
# Required only when EMBEDDING_PROVIDER=huggingface
# HF_TOKEN=your_huggingface_token
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://127.0.0.1:5501,http://localhost:5501
PORT=5000
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
