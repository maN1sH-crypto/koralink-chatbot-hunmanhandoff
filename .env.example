# MongoDB Atlas or another reachable MongoDB server.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=koralink
COLLECTION_NAME=knowledge

# Replace with a long, unique random value before running the app.
SECRET_KEY=replace-with-a-long-random-secret

# Local Flask-served frontend and optional local static frontend (Live Server).
# For Netlify/production, use the exact frontend origin(s), comma separated.
FRONTEND_ORIGIN=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5501,http://localhost:5501
PORT=5000

# Local embeddings are recommended. First startup downloads the model once.
EMBEDDING_PROVIDER=local
EMBEDDING_DEVICE=cpu

# Current groq_client.py initializes all three providers at startup.
# Add valid API keys for each provider before starting Flask.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Only needed if EMBEDDING_PROVIDER=huggingface is selected.
# HF_TOKEN=
